repo:
  owner: slaid098
  name: orch
  path: D:/Python projects/orch
  base_branch: main
  remote: origin

labels:
  queued: agent:queued
  running: agent:running
  needs_human: agent:needs-human
  pr_open: agent:pr-open
  hold: agent:hold

worker:
  image: orch-agent:latest
  model: deepseek-v4.1-flash:cloud
  timeout_minutes: 90
  max_attempts: 3
  autocompact: 200k
  allowed_tools: "Read,Write,Edit,Bash,Glob,Grep"
  setup_commands:
    - uv sync --all-extras
  test_commands:
    - uv run pytest -q

# GitHub checks are polled before the reviewer starts. A failed check returns
# control to the worker; the reviewer never sees a red pull request.
checks:
  timeout_minutes: 30
  poll_seconds: 15
  discovery_seconds: 60

# Two reviewers (quality and security) run in separate read-only containers.
# They have no GitHub token; the internal network only reaches the model and
# Context7 through a narrow gateway. An empty findings array from both approves;
# any finding blocks the merge and consumes one shared worker attempt.
reviewer:
  enabled: true
  image: orch-agent:latest
  model: deepseek-v4.1-flash:cloud
  timeout_minutes: 30
  max_rounds: 3
  autocompact: 200k
  allowed_tools: "Read,Grep,Glob"
  # Approved PRs stay open for manual merge by default. Set true to squash-merge
  # into main after green checks and an empty findings array from both reviewers.
  auto_merge: false

# MCP servers baked into the worker image. Reviewer containers only receive
# codegraph and context7; playwright and antidetect stay worker-only.
mcp:
  enabled: true
  codegraph: true
  context7: true
  playwright: true
  antidetect: false
  # Required when antidetect is true. Public endpoints must use HTTPS.
  # Plain HTTP is accepted only for local or private addresses
  # (localhost, 127.0.0.1, ::1, host.docker.internal, RFC1918, IPv6 ULA).
  # For local antidetect, set enabled true and use:
  # antidetect_url: http://host.docker.internal:8765/mcp/

data_dir: D:/orch/app_data
retention_days: 7
poll_interval_seconds: 30
max_workers: 2

# One-way status messages. The bot token is read from TELEGRAM_BOT_TOKEN or
# from a local env file; never put the token in this YAML.
telegram:
  enabled: false
  chat_id: "123456789"
  # Set this only for a forum topic.
  message_thread_id: null
  # token_file: C:/path/to/.env

# Live comments are injected into the running Claude session. Polling starts
# only after the issue is taken into work.
feedback:
  enabled: true
  live_comments: true
  poll_seconds: 30
  allowed_users:
    - your-github-login

# Clef classifies only when a cheap trigger fires. The policy is deterministic.
watchdog:
  enabled: false
  endpoint: https://ollama.com/v1/systemone
  model: clef
  confidence_threshold: 0.7
  silence_minutes: 10
  min_run_minutes: 15
  max_nudges: 2
  cooldown_minutes: 10
  check_seconds: 60
  max_context_chars: 6000
