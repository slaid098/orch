repo:
  owner: slaid098
  name: orch
  path: D:/Python projects/orch
  base_branch: main
  remote: origin
  # github (default) or forgejo. Forgejo also requires repo.url.
  forge: github
  # url: https://git.slaid098.dev

# To serve several repositories from one daemon, remove the top-level repo
# block and add a projects list. Top-level labels/worker/checks/reviewer/mcp/
# feedback/watchdog are shared defaults; each project deep-merges its own
# sections over them. data_dir, skills_dir, telegram, and the worker-pool and
# retention settings stay global.
#
# projects:
#   - name: orch
#     repo:
#       owner: slaid098
#       name: orch
#       path: D:/Python projects/orch
#       forge: github
#   - name: antidetect
#     repo:
#       owner: slaid098
#       name: antidetect-browser-mcp
#       path: D:/Python projects/antidetect-browser-mcp
#       forge: forgejo
#       url: https://git.slaid098.dev
#     worker:
#       test_commands:
#         - uv run pytest -m "not live" -q

labels:
  queued: agent:queued
  running: agent:running
  needs_human: agent:needs-human
  pr_open: agent:pr-open
  hold: agent:hold

worker:
  image: orch-agent:latest
  model: deepseek-v4.1-flash:cloud
  # Agent phase budget. A stalled run is detected by the watchdog and
  # restarted in the same workspace; this ceiling is only an emergency stop.
  timeout_minutes: 120
  # Independent budget for the verification gate that runs after the agent.
  verify_timeout_minutes: 45
  max_attempts: 3
  autocompact: 200k
  allowed_tools: "Read,Write,Edit,Bash,Glob,Grep"
  # Skill directories under skills_dir (default: ./skills) mounted read-only
  # into the worker at ~/.claude/skills. Missing names fail preflight.
  skills:
    - code-standards
  setup_commands:
    - uv sync --all-extras
  test_commands:
    - uv run pytest -q

# Forge checks are polled before the reviewer starts. A failed check returns
# control to the worker; the reviewer never sees a red pull request.
checks:
  timeout_minutes: 60
  poll_seconds: 15
  discovery_seconds: 60

# Two reviewers (quality and security) run in separate read-only containers.
# They have no forge token; the internal network only reaches the model and
# Context7 through a narrow gateway. An empty findings array from both approves;
# any finding blocks the merge and consumes one shared worker attempt.
reviewer:
  enabled: true
  image: orch-agent:latest
  model: deepseek-v4.1-flash:cloud
  timeout_minutes: 30
  max_rounds: 3
  autocompact: 200k
  allowed_tools: "Read,Grep,Glob"
  skills:
    - code-standards
  # Approved PRs stay open for manual merge by default. Set true to squash-merge
  # into main after green checks and an empty findings array from both reviewers.
  auto_merge: false

# MCP servers baked into the worker image. Reviewer containers only receive
# codegraph and context7; playwright and antidetect stay worker-only.
mcp:
  enabled: true
  codegraph: true
  context7: true
  playwright: true
  antidetect: false
  # Required when antidetect is true. Public endpoints must use HTTPS.
  # Plain HTTP is accepted only for local or private addresses
  # (localhost, 127.0.0.1, ::1, host.docker.internal, RFC1918, IPv6 ULA).
  # For local antidetect, set enabled true and use:
  # antidetect_url: http://host.docker.internal:8765/mcp/

data_dir: D:/orch/app_data
retention_days: 7
workspace_retention_days: 14
min_free_disk_gb: 5
poll_interval_seconds: 30
max_workers: 2

# One-way status messages. The bot token is read from TELEGRAM_BOT_TOKEN or
# from a local env file; never put the token in this YAML.
telegram:
  enabled: false
  chat_id: "123456789"
  # Set this only for a forum topic.
  message_thread_id: null
  # token_file: C:/path/to/.env

# Live comments are injected into the running Claude session. Polling starts
# only after the issue is taken into work.
feedback:
  enabled: true
  live_comments: true
  poll_seconds: 30
  allowed_users:
    - your-github-login

# Clef classifies only when a cheap trigger fires. The policy is deterministic.
watchdog:
  enabled: false
  endpoint: https://ollama.com/v1/systemone
  model: clef
  confidence_threshold: 0.7
  silence_minutes: 10
  min_run_minutes: 15
  max_nudges: 2
  cooldown_minutes: 10
  check_seconds: 60
  max_context_chars: 6000
