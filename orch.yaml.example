repo:
  owner: slaid098
  name: orch
  path: D:/Python projects/orch
  base_branch: main
  remote: origin

labels:
  queued: agent:queued
  running: agent:running
  needs_human: agent:needs-human
  pr_open: agent:pr-open

worker:
  image: orch-agent:latest
  model: deepseek-v4.1-flash:cloud
  timeout_minutes: 90
  max_attempts: 3
  autocompact: 200k
  allowed_tools: "Read,Write,Edit,Bash,Glob,Grep"
  setup_commands:
    - uv sync --all-extras
  test_commands:
    - uv run pytest -q

# GitHub checks are polled before the reviewer starts. A failed check returns
# control to the worker; the reviewer never sees a red pull request.
checks:
  timeout_minutes: 30
  poll_seconds: 15
  discovery_seconds: 60

# The reviewer runs in a separate read-only container. It has no GitHub token
# and may only Read, Grep, and Glob. An empty findings array approves; any
# finding blocks the merge and consumes one shared worker attempt.
reviewer:
  enabled: true
  image: orch-agent:latest
  model: deepseek-v4.1-flash:cloud
  timeout_minutes: 15
  max_rounds: 3
  autocompact: 200k
  allowed_tools: "Read,Grep,Glob"

data_dir: D:/orch/app_data
retention_days: 7
poll_interval_seconds: 30
max_workers: 2

# One-way status messages. The bot token is read from TELEGRAM_BOT_TOKEN or
# from a local env file; never put the token in this YAML.
telegram:
  enabled: false
  chat_id: "123456789"
  # Set this only for a forum topic.
  message_thread_id: null
  # token_file: C:/path/to/.env

# Live comments are injected into the running Claude session. Polling starts
# only after the issue is taken into work.
feedback:
  enabled: true
  live_comments: true
  poll_seconds: 30
  allowed_users:
    - your-github-login

# Clef classifies only when a cheap trigger fires. The policy is deterministic.
watchdog:
  enabled: false
  endpoint: https://ollama.com/v1/systemone
  model: clef
  confidence_threshold: 0.7
  silence_minutes: 10
  min_run_minutes: 15
  max_nudges: 2
  cooldown_minutes: 10
  check_seconds: 60
  max_context_chars: 6000
